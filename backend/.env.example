# Copy to .env and adjust. Everything here has a working development default
# except DJANGO_SECRET_KEY, which must be set before deploying anywhere real.

DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Turn on only behind a load balancer that sets X-Forwarded-Proto. Trusting
# it otherwise lets a client claim HTTPS and defeat the Secure cookie flags.
TRUST_PROXY_SSL_HEADER=false

# Where the SPA runs. FRONTEND_URL is what magic links point at.
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# sqlite by default; switch to postgres when the run queue arrives.
# DATABASE_URL=postgres://qa_agent:qa_agent@localhost:5432/qa_agent

# Leave empty to allow any domain (fine locally). In production set this to the
# company domains that may sign in, e.g. yourcompany.com,contractors.example
ALLOWED_EMAIL_DOMAINS=

# Idle expiry slides with activity. The absolute cap counts from sign-in and
# ignores activity, so no session lives forever - including a stolen one.
SESSION_IDLE_TIMEOUT_HOURS=12
SESSION_ABSOLUTE_TIMEOUT_HOURS=168

# Encrypts Linear / Azure DevOps credentials at rest. Generate with:
#   python manage.py generate_encryption_key
# Required outside development. Keep it SEPARATE from DJANGO_SECRET_KEY:
# rotating SECRET_KEY signs everyone out, and must not also make every
# stored third-party credential unreadable.
CREDENTIAL_ENCRYPTION_KEY=

MAGIC_LINK_TTL_MINUTES=15
MAGIC_LINK_MAX_PER_EMAIL_PER_HOUR=5
MAGIC_LINK_MAX_PER_IP_PER_HOUR=20

# consolemail:// prints the link to the runserver console — no SMTP needed.
# EMAIL_URL=smtp://user:password@smtp.example.com:587/?tls=True
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=QA Agent <qa-agent@localhost>

# SSO. A provider only appears as available once BOTH id and secret are set.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
